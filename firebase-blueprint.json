{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authorized property owner profile in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 255 },
        "role": { "type": "string", "enum": ["owner"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Property": {
      "title": "Property",
      "description": "Rental property managed by the owner.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "address": { "type": "string", "minLength": 3, "maxLength": 255 },
        "monthlyRentAmount": { "type": "integer" },
        "dueDay": { "type": "integer" },
        "tenantId": { "type": "string", "maxLength": 128 },
        "leaseStartDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "leaseEndDate": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerUid", "name", "address", "monthlyRentAmount", "dueDay", "leaseStartDate", "active"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Tenant occupying or associated with a property.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 255 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerUid", "fullName", "phone", "active"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Monthly rental obligation and payment record.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "amountDue": { "type": "integer" },
        "dueDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "paidAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerUid", "propertyId", "period", "amountDue", "dueDate", "status"]
    },
    "ReminderLog": {
      "title": "ReminderLog",
      "description": "Log of automated rental due reminders sent to the owner.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "recipient": { "type": "string", "maxLength": 255 },
        "scheduledFor": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["processing", "sent", "failed"] },
        "providerMessageId": { "type": "string", "maxLength": 255 },
        "attempts": { "type": "integer" },
        "lastError": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerUid", "paymentId", "propertyId", "period", "recipient", "scheduledFor", "status", "attempts"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Application settings and notification preferences for the owner.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "notificationEmail": { "type": "string", "format": "email", "maxLength": 255 },
        "reminderHour": { "type": "integer" },
        "timezone": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerUid", "notificationEmail", "timezone"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Owner authentication and role record."
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Properties registered and managed by the owner."
    },
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Tenants registered by the owner."
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Monthly rental obligations keyed deterministically by propertyId_period."
    },
    "/reminderLogs/{logId}": {
      "schema": "ReminderLog",
      "description": "Logs of automated reminder dispatches keyed deterministically by paymentId."
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Owner settings document keyed by owner UID."
    }
  }
}
